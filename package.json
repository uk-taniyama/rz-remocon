{
  "name": "rz-remocon",
  "version": "0.0.0-alpha.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rz-remocon": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./gen": {
      "types": "./dist/gen.d.ts",
      "import": "./dist/gen.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "server": "tsx src/cli/index.ts server -p 8484 -d ./dist/public",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/cli/index.ts server -p 8484 -d ./dist/public",
    "cli": "tsx src/cli/index.ts",
    "default-remocon": "tsx --tsconfig tsconfig.gen.json src/gen/default-remocon.ts data",
    "build": "./scripts/build.sh",
    "test": "vitest",
    "tsc": "tsc -b --noEmit",
    "check": "biome check --write .",
    "lint": "npm run check && npm run tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/openapi": "^1.15.4",
    "@orpc/openapi-client": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/zod": "^1.15.4",
    "@remixicon/react": "^4.9.0",
    "commander": "^15.0.0",
    "digest-fetch": "^3.1.1",
    "hono": "^4.13.9",
    "nanoid": "^6.0.2",
    "undici": "^8.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fluid-tools/api-markdown-documenter": "^0.24.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "globals": "^17.12.0",
    "gridstack": "^14.0.0",
    "jsdom": "^30.1.2",
    "markdown-it": "^15.0.3",
    "markserv": "^1.21.1",
    "mdast": "^2.3.2",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "remark-parse": "^11.0.0",
    "safe-stable-stringify": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
